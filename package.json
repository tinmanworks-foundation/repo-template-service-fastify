{
  "name": "repo-template-service-fastify",
  "version": "0.1.0",
  "private": true,
  "description": "Generalized service template using Node.js, TypeScript, and Fastify.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.2",
    "fastify": "5.2.1",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "eslint": "9.21.0",
    "prettier": "3.5.2",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  },
  "packageManager": "pnpm@10.6.3"
}
